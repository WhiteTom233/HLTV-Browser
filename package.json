{
  "name": "hltv-browser-vscode-extension",
  "displayName": "HLTV Browser",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:hltv.matches",
    "onView:hltv.results",
    "onView:hltv.news",
    "onCommand:hltv.refresh"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hltv",
          "title": "HLTV",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "hltv": [
        {
          "id": "hltv.matches",
          "name": "Matches",
          "icon": "resources/icon.svg"
        },
        {
          "id": "hltv.results",
          "name": "Results",
          "icon": "resources/icon.svg"
        },
        {
          "id": "hltv.news",
          "name": "News",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "hltv.refresh",
        "title": "HLTV: Refresh data"
      },
      {
        "command": "hltv.copyNewsArticle",
        "title": "HLTV: Copy Content"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hltv.refresh",
          "when": "view == hltv.matches || view == hltv.results || view == hltv.news",
          "group": "navigation",
          "position": "before"
        }
      ],
      "view/item/context": [
        {
          "command": "hltv.copyNewsArticle",
          "when": "view == hltv.news && viewItem == news",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "vscode:prepublish": "npm run package",
    "package": "npm run check-types && node esbuild.js --production"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "playwright": "^1.55.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Cyril-44/HLTV-Browser.git"
  }
}
